# Copy to .env and fill in. Save as UTF-8 without a BOM:
# PowerShell's `>` and Set-Content default to UTF-16/ANSI, which dotenv cannot parse.
# Use: Set-Content -Encoding utf8 .env   (or edit in an editor set to UTF-8)

# Supabase project URL and PUBLIC anon key. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Required for uncached online lookups. Deploy scripts/cloudflare-worker.js and paste its URL.
VITE_CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev

# Shared secret required by POST /api/manual-entry. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANUAL_ENTRY_TOKEN=
